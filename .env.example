# Your personal Oniesoft API key (required).
# Generate one in the platform under Users → API Keys.
# Project IDs and API URLs go in config.json — not here.
PLATFORM_API_KEY=your-oniesoft-api-key-here

# Optional overrides (omit if config.json already has them):
# PLATFORM_API_URL=http://localhost:8000
# BACKEND_URL=http://localhost:8088
