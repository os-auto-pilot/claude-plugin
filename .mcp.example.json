{
  "mcpServers": {
    "oniesoft": {
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--python", ">=3.10",
        "${CLAUDE_PLUGIN_ROOT}/server/venv_launcher.py"
      ],
      "env": {
        "PLATFORM_API_URL": "${user_config.platform_api_url}",
        "EXECUTION_API_URL": "${user_config.execution_api_url}",
        "BACKEND_URL": "${user_config.backend_url}",
        "PLATFORM_API_KEY": "${user_config.platform_api_key}",
        "PLATFORM_COMPANY_ID": "${user_config.default_company_id}",
        "PLATFORM_PROJECT_ID": "${user_config.default_project_id}",
        "PLATFORM_USER_ID": "${user_config.default_user_id}"
      }
    }
  }
}
